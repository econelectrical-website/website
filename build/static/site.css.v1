/* Econ Electrical
   Layout: black site in the brand's own colours; photography carries each page,
   the logo's diagonal bars return as a hatch detail, project facts read like a tender schedule. */
@font-face { font-family: "Archivo Local"; src: url("fonts/archivo-latin-wdth.woff2") format("woff2"); font-weight: 100 900; font-stretch: 62% 125%; font-style: normal; font-display: swap; }
@font-face { font-family: "Plex Mono Local"; src: url("fonts/ibm-plex-mono-latin-400.woff2") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
@font-face { font-family: "Plex Mono Local"; src: url("fonts/ibm-plex-mono-latin-500.woff2") format("woff2"); font-weight: 500; font-style: normal; font-display: swap; }

:root {
  color-scheme: dark;
  --black: #000000;      /* header, hero, footer, logo tile */
  --coal: #0a0b09;       /* page background, nudged toward the brand green */
  --graphite: #141613;   /* raised panels, shaded rows */
  --steel: #2b2f2a;      /* hairlines and hatching */
  --ash: #9da298;        /* secondary text */
  --text: #d6d9d2;       /* running text */
  --chalk: #f0f2ed;      /* headings and key text */
  --sage: #9eca84;       /* brand accent, used sparingly */
  --display: "Archivo Local", "Archivo", "Helvetica Neue", Arial, sans-serif;
  --body: "Archivo Local", "Archivo", "Helvetica Neue", Arial, sans-serif;
  --mono: "Plex Mono Local", "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --gutter: clamp(16px, 4vw, 40px);
  --maxw: 1240px;
  --header-h: 80px;
  --hatch: repeating-linear-gradient(135deg, var(--steel) 0 2px, transparent 2px 10px);
}

*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: calc(var(--header-h) + 16px); }
body {
  margin: 0;
  background: var(--coal);
  color: var(--text);
  font-family: var(--body);
  font-size: 1.0625rem;
  line-height: 1.65;
  font-stretch: 100%;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
body.menu-locked { overflow: hidden; }
img, video { max-width: 100%; height: auto; display: block; }
a { color: inherit; }
p, figure, blockquote, dl, dd { margin: 0; }
:focus-visible { outline: 2px solid var(--sage); outline-offset: 3px; }
.skip-link { position: absolute; left: 16px; top: -60px; z-index: 100; background: var(--sage); color: var(--black); padding: 10px 14px; font-weight: 600; text-decoration: none; }
.skip-link:focus { top: 12px; }
.visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

.container { width: 100%; max-width: calc(var(--maxw) + 2 * var(--gutter)); margin-inline: auto; padding-inline: var(--gutter); }

/* Type */
h1, h2, h3, h4 { font-family: var(--display); color: var(--chalk); margin: 0; line-height: 1.06; letter-spacing: -0.012em; text-wrap: balance; }
h1 { font-size: clamp(2.15rem, 1.45rem + 2.9vw, 3.65rem); font-weight: 800; font-stretch: 112%; }
h2 { font-size: clamp(1.8rem, 1.3rem + 2vw, 2.85rem); font-weight: 780; font-stretch: 112%; }
h3 { font-size: clamp(1.18rem, 1.06rem + 0.5vw, 1.42rem); font-weight: 700; font-stretch: 106%; line-height: 1.2; letter-spacing: -0.005em; }
.accent { color: var(--sage); }
.lede { font-size: clamp(1.08rem, 1rem + 0.35vw, 1.24rem); color: var(--ash); max-width: 56ch; line-height: 1.6; }
.eyebrow, .label { font-family: var(--mono); font-size: 0.76rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; }
.eyebrow { color: var(--sage); }
.label { color: var(--ash); }
.stack { display: grid; gap: 16px; align-content: start; }
.stack-lg { display: grid; gap: 24px; align-content: start; }
.copy { display: grid; gap: 1em; max-width: 64ch; }

/* Buttons and links */
.btn {
  display: inline-flex; align-items: center; gap: 0.6em;
  padding: 0.95em 1.35em; min-height: 48px;
  font: 600 0.98rem/1 var(--body); font-stretch: 108%;
  text-decoration: none; border: 1px solid transparent; border-radius: 2px; cursor: pointer;
  transition: background-color .2s ease, border-color .2s ease, color .2s ease;
}
.btn svg { width: 1.05em; height: 1.05em; flex: none; }
.btn-primary { background: var(--sage); color: var(--black); }
.btn-primary:hover { background: var(--chalk); }
.btn-ghost { border-color: var(--steel); color: var(--chalk); background: transparent; }
.btn-ghost:hover { border-color: var(--chalk); }
.btn-row { display: flex; flex-wrap: wrap; gap: 12px; }
.text-link {
  display: inline-flex; align-items: center; gap: 0.5em; align-self: start; justify-self: start;
  color: var(--chalk); font-weight: 600; text-decoration: none;
  border-bottom: 1px solid var(--sage); padding-bottom: 3px;
}
.text-link svg { width: 1em; height: 1em; transition: transform .2s ease; }
.text-link:hover svg { transform: translateX(3px); }
.mono-link { font-family: var(--mono); font-size: 0.92rem; text-decoration: none; color: var(--chalk); }
.mono-link:hover { color: var(--sage); }

/* Header */
.site-header { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: var(--black); border-bottom: 1px solid var(--steel); }
.header-inner { display: flex; align-items: center; gap: clamp(12px, 2vw, 28px); min-height: var(--header-h); }
.brand { flex: none; display: block; line-height: 0; }
.brand img { height: 60px; width: auto; }
.nav { margin-left: auto; }
.nav-list { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
.nav-link {
  display: inline-flex; align-items: center; gap: 6px; padding: 10px 12px;
  font: 500 0.97rem/1.2 var(--body); color: var(--chalk); text-decoration: none;
  background: none; border: 0; cursor: pointer;
}
.nav-link svg { width: 12px; height: 12px; transition: transform .2s ease; }
.nav-link:hover, .nav-link[aria-current="page"], .has-menu.is-current > .nav-link { color: var(--sage); }
.has-menu { position: relative; }
.submenu {
  position: absolute; top: calc(100% + 8px); left: -8px; z-index: 5;
  min-width: 320px; margin: 0; padding: 8px; list-style: none;
  background: var(--graphite); border: 1px solid var(--steel);
  display: none;
}
.submenu::before { content: ""; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
.has-menu:hover .submenu, .has-menu:focus-within .submenu, .has-menu.open .submenu { display: block; }
.has-menu:hover > .nav-link svg, .has-menu.open > .nav-link svg { transform: rotate(180deg); }
.submenu a { display: grid; gap: 2px; padding: 10px 12px; text-decoration: none; color: var(--chalk); font-weight: 500; }
.submenu a:hover, .submenu a[aria-current="page"] { background: var(--coal); color: var(--sage); }
.submenu .meta { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ash); font-weight: 400; }
.submenu .all a { border-top: 1px solid var(--steel); margin-top: 6px; padding-top: 14px; color: var(--sage); }
.header-phone { font-family: var(--mono); font-size: 0.9rem; color: var(--chalk); text-decoration: none; white-space: nowrap; }
.header-phone:hover { color: var(--sage); }
.header-cta { padding: 0.8em 1.15em; min-height: 44px; }
.menu-toggle { display: none; }
.nav-extra { display: none; }

@media (max-width: 1080px) {
  :root { --header-h: 68px; }
  .brand img { height: 50px; }
  .header-cta { display: none; }
  .header-phone { margin-left: auto; }
  .menu-toggle {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px;
    background: transparent; color: var(--chalk); border: 1px solid var(--steel); border-radius: 2px;
    font: 500 0.78rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer;
  }
  .menu-toggle .bars { width: 18px; height: 12px; position: relative; display: block; }
  .menu-toggle .bars::before, .menu-toggle .bars::after, .menu-toggle .bars span { content: ""; position: absolute; left: 0; right: 0; height: 2px; background: currentColor; transition: transform .2s ease, opacity .2s ease; }
  .menu-toggle .bars::before { top: 0; }
  .menu-toggle .bars span { top: 5px; }
  .menu-toggle .bars::after { bottom: 0; }
  .site-header.menu-open .menu-toggle .bars::before { transform: translateY(5px) rotate(45deg); }
  .site-header.menu-open .menu-toggle .bars span { opacity: 0; }
  .site-header.menu-open .menu-toggle .bars::after { transform: translateY(-5px) rotate(-45deg); }
  .nav {
    display: none; position: fixed; left: 0; right: 0; bottom: 0;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    background: var(--black); overflow-y: auto; margin: 0;
    padding: 12px var(--gutter) calc(32px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--steel);
  }
  .site-header.menu-open .nav { display: block; }
  .nav-list { display: grid; gap: 0; align-items: stretch; }
  .nav-list > li { border-bottom: 1px solid var(--steel); }
  .nav-link { width: 100%; justify-content: space-between; padding: 16px 0; font-size: 1.15rem; font-stretch: 108%; font-weight: 650; }
  .has-menu > .nav-link { pointer-events: none; color: var(--ash); font-family: var(--mono); font-size: 0.76rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 500; padding-bottom: 4px; }
  .has-menu > .nav-link svg { display: none; }
  .submenu { position: static; display: block; min-width: 0; padding: 0 0 12px; background: none; border: 0; }
  .submenu::before { display: none; }
  .submenu a { padding: 10px 0; font-size: 1.05rem; }
  .submenu a:hover { background: none; }
  .submenu .all a { border-top: 0; margin-top: 0; padding-top: 10px; }
  .nav-extra { display: grid; gap: 14px; padding-top: 24px; }
  .nav-extra .btn { justify-content: center; }
}
@media (max-width: 520px) {
  .header-phone .num { display: none; }
  .header-phone::after { content: "Call"; font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .header-phone { border: 1px solid var(--steel); padding: 0 14px; min-height: 44px; display: inline-flex; align-items: center; border-radius: 2px; }
}

/* Sections */
.section { padding-block: clamp(56px, 8vw, 112px); }
.section-tight { padding-block: clamp(40px, 6vw, 72px); }
.section-black { background: var(--black); }
.rule-top { border-top: 1px solid var(--steel); }
.section-head { display: grid; gap: 14px; max-width: 760px; margin-bottom: clamp(32px, 4.5vw, 56px); }
.section-head.split-head { max-width: none; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 24px; }
.section-head .lede { max-width: 62ch; }

/* Home hero */
.hero { background: var(--black); border-bottom: 1px solid var(--steel); padding-block: clamp(40px, 7vw, 96px) clamp(56px, 8vw, 112px); overflow-x: clip; }
.hero-grid { display: grid; grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr); gap: clamp(36px, 5vw, 80px); align-items: center; }
.hero-copy { display: grid; gap: 24px; }
.hero h1 .accent { display: block; }
.trust-line { display: flex; flex-wrap: wrap; gap: 6px 18px; list-style: none; margin: 4px 0 0; padding: 0; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); }
.trust-line li { display: inline-flex; align-items: center; gap: 8px; }
.trust-line li::before { content: ""; width: 10px; height: 2px; background: var(--sage); transform: rotate(-45deg); }
.hero-media { position: relative; margin: 0 clamp(10px, 2.2vw, 30px) clamp(10px, 2.2vw, 30px) 0; }
.hero-media::before { content: ""; position: absolute; inset: clamp(10px, 2.2vw, 30px) calc(-1 * clamp(10px, 2.2vw, 30px)) calc(-1 * clamp(10px, 2.2vw, 30px)) clamp(10px, 2.2vw, 30px); background: var(--hatch); }
.hero-media video, .hero-media > img { position: relative; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--graphite); }
.video-toggle {
  position: absolute; right: 12px; bottom: 12px; z-index: 2;
  display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 12px;
  background: rgba(0, 0, 0, 0.72); color: var(--chalk); border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 2px;
  font: 500 0.7rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer;
}
.video-toggle svg { width: 12px; height: 12px; }
.media-caption { position: relative; margin-top: 12px; }
@media (max-width: 900px) {
  .hero-grid { grid-template-columns: minmax(0, 1fr); }
}

/* Pillars band */
.pillars { background: var(--coal); border-bottom: 1px solid var(--steel); }
.pillars-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.pillar { display: grid; gap: 10px; align-content: start; padding: clamp(28px, 4vw, 48px) clamp(20px, 2.6vw, 40px); border-left: 1px solid var(--steel); }
.pillar:first-child { border-left: 0; padding-left: 0; }
.pillar:last-child { padding-right: 0; }
.pillar p { color: var(--ash); max-width: 38ch; }
@media (max-width: 820px) {
  .pillars-grid { grid-template-columns: minmax(0, 1fr); }
  .pillar, .pillar:first-child, .pillar:last-child { border-left: 0; border-top: 1px solid var(--steel); padding-inline: 0; }
  .pillar:first-child { border-top: 0; }
}

/* Two column split */
.split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 5.5vw, 88px); align-items: center; }
.split-media { position: relative; }
.split-media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
.split-media.tall img { aspect-ratio: 4 / 5; }
.split-reverse > .split-media { order: 2; }
@media (max-width: 900px) {
  .split { grid-template-columns: minmax(0, 1fr); }
  .split-reverse > .split-media { order: 0; }
}

/* Accreditation inline list */
.accred { display: flex; flex-wrap: wrap; gap: 10px 28px; align-items: center; padding-top: 8px; }
.accred img { height: 40px; width: auto; opacity: 0.9; }

/* Home services */
.service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 3vw, 44px); }
.service-card { display: grid; gap: 18px; align-content: start; }
.service-card .media { display: block; overflow: hidden; background: var(--graphite); }
.service-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .5s ease; }
.service-card .media:hover img { transform: scale(1.03); }
.service-card p { color: var(--ash); }
@media (max-width: 900px) { .service-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; } }

/* Call to action */
.cta { background: var(--graphite); border-block: 1px solid var(--steel); }
.cta-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: stretch; }
.cta-copy { display: grid; gap: 18px; align-content: center; padding-block: clamp(48px, 7vw, 96px); padding-right: clamp(24px, 5vw, 80px); }
.cta-copy p { color: var(--ash); max-width: 46ch; }
.cta-media { position: relative; min-height: 280px; }
.cta-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.cta-simple .cta-grid { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 32px; }
.cta-simple .cta-copy { padding-block: clamp(44px, 6vw, 80px); padding-right: 0; }
.cta-strip { width: 100%; height: 10px; background: var(--hatch); }
@media (max-width: 900px) {
  .cta-grid, .cta-simple .cta-grid { grid-template-columns: minmax(0, 1fr); }
  .cta-copy { padding-right: 0; }
  .cta-simple .cta-grid { gap: 0; padding-bottom: clamp(44px, 6vw, 80px); }
  .cta-media { min-height: 0; aspect-ratio: 16 / 9; margin-bottom: var(--gutter); }
}

/* Project cards */
.project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 2.4vw, 32px); }
.project-grid.index { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.project-grid.index > :nth-child(-n+2) { grid-column: span 3; }
.project-grid.index > :nth-child(n+3) { grid-column: span 2; }
.project-card { display: flex; flex-direction: column; text-decoration: none; color: inherit; background: var(--graphite); }
.project-card .media { overflow: hidden; }
.project-card img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .5s ease; }
.project-card:hover img { transform: scale(1.03); }
.project-card .body { display: grid; gap: 8px; padding: 20px 22px 24px; }
.project-card h3 { transition: color .2s ease; }
.project-card:hover h3 { color: var(--sage); }
.project-card .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); }
@media (max-width: 900px) {
  .project-grid, .project-grid.index { grid-template-columns: minmax(0, 1fr); }
  .project-grid.index > :nth-child(n) { grid-column: auto; }
}

/* Partners and accreditations strip */
.logos { background: var(--black); border-top: 1px solid var(--steel); }
.logos-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: clamp(32px, 5vw, 72px); padding-block: clamp(40px, 6vw, 72px); }
.logo-group { display: grid; gap: 22px; align-content: start; }
.logo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 22px clamp(28px, 4vw, 56px); }
.logo-row img { height: 46px; width: auto; opacity: 0.92; }
.logo-row img.short { height: 56px; }
@media (max-width: 820px) { .logos-grid { grid-template-columns: minmax(0, 1fr); } }

/* Inner page hero */
.page-hero { background: var(--black); border-bottom: 1px solid var(--steel); padding-block: clamp(32px, 5vw, 72px) clamp(44px, 6vw, 88px); overflow-x: clip; }
.page-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
.page-hero-grid.solo { grid-template-columns: minmax(0, 1fr); }
.page-hero .copy-col { display: grid; gap: 22px; }
.page-hero-media img { width: 100%; aspect-ratio: 16 / 11; object-fit: cover; }
.crumbs { display: flex; flex-wrap: wrap; gap: 6px 10px; list-style: none; margin: 0; padding: 0; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); }
.crumbs a { text-decoration: none; }
.crumbs a:hover { color: var(--sage); }
.crumbs li + li::before { content: "/"; margin-right: 10px; color: var(--steel); }
@media (max-width: 900px) { .page-hero-grid { grid-template-columns: minmax(0, 1fr); } }

/* Service features */
.features { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(24px, 3vw, 40px); margin-top: clamp(36px, 5vw, 60px); }
.feature { display: grid; gap: 10px; align-content: start; padding-top: 20px; border-top: 1px solid var(--steel); position: relative; }
.feature::before { content: ""; position: absolute; top: -1px; left: 0; width: 40px; height: 2px; background: var(--sage); }
.feature p { color: var(--ash); font-size: 0.98rem; }
@media (max-width: 1000px) { .features { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .features { grid-template-columns: minmax(0, 1fr); } }

/* Service offers */
.offer { padding-block: clamp(44px, 6vw, 88px); border-top: 1px solid var(--steel); }
.offer .copy { gap: 1em; }
.checklist { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 28px; }
.checklist li, .scope li { position: relative; padding-left: 26px; color: var(--chalk); }
.checklist li::before, .scope li::before { content: ""; position: absolute; left: 2px; top: 0.78em; width: 13px; height: 2px; background: var(--sage); transform: rotate(-45deg); }
@media (max-width: 560px) { .checklist { grid-template-columns: minmax(0, 1fr); } }

/* Process line, drawn like a busbar with four taps */
.process { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.process li { position: relative; display: grid; gap: 10px; align-content: start; padding: 48px clamp(16px, 2.4vw, 36px) 0 0; }
.process li::before { content: ""; position: absolute; left: 0; right: 0; top: 15px; height: 2px; background: var(--steel); }
.process li::after { content: ""; position: absolute; left: 0; top: 8px; width: 16px; height: 16px; border-radius: 50%; background: var(--coal); border: 2px solid var(--sage); }
.process p { color: var(--ash); font-size: 0.98rem; }
@media (max-width: 900px) {
  .process { grid-template-columns: minmax(0, 1fr); }
  .process li { padding: 0 0 32px 40px; }
  .process li:last-child { padding-bottom: 0; }
  .process li::before { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
  .process li:last-child::before { bottom: auto; height: 12px; }
  .process li::after { top: 4px; }
}

/* Coverage */
.coverage-list { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--steel); max-width: 460px; }
.coverage-list li { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--steel); color: var(--chalk); font-weight: 600; }
.coverage-list li span { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); font-weight: 400; }

/* FAQ */
.faq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: clamp(32px, 5vw, 80px); }
.faq { border-top: 1px solid var(--steel); }
.faq details { border-bottom: 1px solid var(--steel); }
.faq summary { list-style: none; cursor: pointer; position: relative; padding: 22px 48px 22px 0; font-family: var(--display); font-size: 1.12rem; font-weight: 650; font-stretch: 106%; color: var(--chalk); }
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; position: absolute; right: 6px; top: 50%; transform: translateY(-50%); font-family: var(--mono); font-size: 1.4rem; font-weight: 400; color: var(--sage); }
.faq details[open] summary::after { content: "\2212"; }
.faq summary:hover { color: var(--sage); }
.faq details p { padding-bottom: 24px; color: var(--ash); max-width: 64ch; }
@media (max-width: 900px) { .faq-grid { grid-template-columns: minmax(0, 1fr); } }

/* Project detail */
.project-top { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
.spec { display: grid; border-top: 1px solid var(--steel); }
.spec > div { display: grid; grid-template-columns: minmax(96px, 38%) minmax(0, 1fr); gap: 16px; padding: 13px 16px; }
.spec > div:nth-child(odd) { background: var(--graphite); }
.spec dt { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); padding-top: 3px; }
.spec dd { color: var(--chalk); font-weight: 600; }
.scope { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
.results { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; padding-block: 8px; }
.result { display: grid; gap: 6px; padding-top: 18px; border-top: 1px solid var(--steel); }
.result strong { font-family: var(--display); font-size: clamp(3rem, 2rem + 4vw, 5.2rem); font-weight: 800; font-stretch: 118%; line-height: 0.95; color: var(--sage); font-variant-numeric: tabular-nums; }
.result span { color: var(--ash); }
.project-figure img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
@media (max-width: 900px) { .project-top { grid-template-columns: minmax(0, 1fr); } }

/* Gallery */
.gallery { columns: 3 240px; column-gap: 12px; }
.gallery a { display: block; margin-bottom: 12px; break-inside: avoid; overflow: hidden; background: var(--graphite); position: relative; }
.gallery img { width: 100%; height: auto; transition: transform .5s ease, opacity .3s ease; }
.gallery a:hover img { transform: scale(1.025); }
.gallery a:focus-visible { outline-offset: 2px; }

/* Testimonial */
.quote { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(16px, 3vw, 40px); align-items: start; }
.quote-mark { font-family: var(--display); font-weight: 800; font-stretch: 125%; font-size: clamp(5rem, 4rem + 4vw, 8rem); line-height: 0.8; color: var(--sage); }
.quote blockquote p { font-family: var(--display); font-size: clamp(1.3rem, 1.05rem + 1.1vw, 2rem); font-weight: 500; font-stretch: 106%; line-height: 1.32; color: var(--chalk); max-width: 36ch; }
.quote figcaption { margin-top: 22px; display: grid; gap: 2px; }
.quote figcaption strong { color: var(--chalk); font-weight: 650; }
.quote figcaption span { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); }

.next-link { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-block: 32px; border-top: 1px solid var(--steel); text-decoration: none; }
.next-link .label { display: block; margin-bottom: 6px; }
.next-link h3 { transition: color .2s ease; }
.next-link:hover h3 { color: var(--sage); }
.next-link svg { width: 28px; height: 28px; color: var(--sage); flex: none; }

/* Team */
.team-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(36px, 4vw, 56px) clamp(20px, 2.5vw, 36px); }
.member { display: grid; gap: 14px; align-content: start; }
.member img { width: 100%; aspect-ratio: 1; object-fit: cover; filter: grayscale(1) contrast(1.06); background: var(--graphite); }
.member .role { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sage); }
.member p { color: var(--ash); font-size: 0.98rem; }
.member .mono-link { font-size: 0.8rem; justify-self: start; border-bottom: 1px solid var(--steel); padding-bottom: 2px; }
@media (max-width: 900px) { .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .team-grid { grid-template-columns: minmax(0, 1fr); } }

/* Contact */
.contact-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(36px, 5vw, 88px); align-items: start; }
.form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
.field { display: grid; gap: 8px; }
.field.full { grid-column: 1 / -1; }
.field label { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); }
.field label .opt { text-transform: none; letter-spacing: 0.02em; color: var(--ash); opacity: 0.75; }
.field input, .field textarea {
  width: 100%; font: inherit; color: var(--chalk); background: var(--graphite);
  border: 1px solid var(--steel); border-radius: 2px; padding: 14px 16px; min-height: 52px;
}
.field textarea { min-height: 180px; resize: vertical; }
.field input:focus, .field textarea:focus { outline: none; border-color: var(--sage); box-shadow: 0 0 0 1px var(--sage); }
.form-foot { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
.form-note { color: var(--ash); font-size: 0.92rem; max-width: 52ch; }
.form-status { grid-column: 1 / -1; padding: 16px 18px; background: var(--graphite); border-left: 2px solid var(--sage); color: var(--chalk); }
.hp { position: absolute !important; left: -9999px; }
.contact-card { display: grid; gap: 0; border-top: 1px solid var(--steel); }
.contact-card > div { display: grid; gap: 6px; padding: 20px 0; border-bottom: 1px solid var(--steel); }
.contact-card address { font-style: normal; color: var(--chalk); }
.contact-card .big { font-family: var(--display); font-size: 1.35rem; font-weight: 700; font-stretch: 108%; color: var(--chalk); text-decoration: none; }
.contact-card .big:hover { color: var(--sage); }
@media (max-width: 900px) { .contact-grid { grid-template-columns: minmax(0, 1fr); } }
@media (max-width: 560px) { .form { grid-template-columns: minmax(0, 1fr); } }

/* Blog */
.post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(36px, 4vw, 56px) clamp(20px, 2.6vw, 36px); }
.post-card { display: grid; gap: 14px; align-content: start; text-decoration: none; color: inherit; }
.post-card .media { overflow: hidden; background: var(--graphite); }
.post-card img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform .5s ease; }
.post-card:hover img { transform: scale(1.03); }
.post-card h2, .post-card h3 { font-size: 1.22rem; font-stretch: 104%; font-weight: 700; line-height: 1.25; transition: color .2s ease; }
.post-card:hover h2, .post-card:hover h3 { color: var(--sage); }
.post-card p { color: var(--ash); font-size: 0.98rem; }
.post-card time, .article-meta { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); }
@media (max-width: 760px) { .post-grid { grid-template-columns: minmax(0, 1fr); } }

.article-head { display: grid; gap: 22px; max-width: 900px; }
.article-head h1 { font-size: clamp(1.9rem, 1.35rem + 2.3vw, 3.1rem); font-stretch: 108%; }
.article-figure { margin-top: clamp(28px, 4vw, 48px); }
.article-figure img { width: 100%; max-height: 560px; object-fit: cover; }
.article-body { max-width: 70ch; margin-inline: auto; }
.prose { color: var(--text); }
.prose > * + * { margin-top: 1.1em; }
.prose h2 { font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.85rem); font-stretch: 108%; margin-top: 1.9em; }
.prose h3 { margin-top: 1.6em; }
.prose h2 + *, .prose h3 + * { margin-top: 0.6em; }
.prose ul, .prose ol { padding-left: 1.3em; }
.prose li + li { margin-top: 0.55em; }
.prose li::marker { color: var(--sage); }
.prose strong { color: var(--chalk); font-weight: 650; }
.prose em { color: var(--chalk); }
.prose a { color: var(--sage); text-underline-offset: 3px; }
.share { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--steel); }
.share a, .share button { font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.06em; color: var(--chalk); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-decoration-color: var(--steel); text-underline-offset: 4px; }
.share a:hover, .share button:hover { color: var(--sage); }

/* Footer */
.site-footer { background: var(--black); color: var(--ash); }
.footer-strip { height: 12px; background: var(--hatch); border-top: 1px solid var(--steel); }
.footer-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 0.8fr)) minmax(0, 1.2fr); gap: clamp(32px, 4vw, 56px); padding-block: clamp(48px, 6vw, 80px) clamp(36px, 5vw, 56px); }
.footer-brand { display: grid; gap: 18px; align-content: start; }
.footer-brand img.logo { height: 96px; width: auto; }
.footer-brand p { max-width: 30ch; }
.footer-col { display: grid; gap: 14px; align-content: start; }
.footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.footer-col a { text-decoration: none; color: var(--chalk); }
.footer-col a:hover { color: var(--sage); }
.footer-col address { font-style: normal; color: var(--chalk); line-height: 1.55; }
.footer-accred { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
.footer-accred img { height: 34px; width: auto; opacity: 0.85; }
.socials { display: flex; flex-wrap: wrap; gap: 8px 18px; font-family: var(--mono); font-size: 0.8rem; }
.socials a { color: var(--chalk); text-decoration: none; }
.socials a:hover { color: var(--sage); }
.footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; padding-block: 20px calc(20px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--steel); font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.04em; }
@media (max-width: 1000px) { .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .footer-grid { grid-template-columns: minmax(0, 1fr); } }

/* WhatsApp button */
.chat-float {
  position: fixed; z-index: 40; right: max(16px, env(safe-area-inset-right, 0px));
  bottom: calc(16px + env(safe-area-inset-bottom, 0px));
  display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 18px;
  background: var(--sage); color: var(--black); border-radius: 999px; text-decoration: none;
  font: 600 0.92rem/1 var(--body); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
}
.chat-float svg { width: 18px; height: 18px; }
.chat-float:hover { background: var(--chalk); }
@media (max-width: 640px) {
  .chat-float { width: 52px; height: 52px; padding: 0; justify-content: center; }
  .chat-float span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .chat-float svg { width: 22px; height: 22px; }
}

/* Lightbox */
.lightbox { width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; margin: 0; padding: 0; border: 0; background: rgba(0, 0, 0, 0.96); color: var(--chalk); }
.lightbox::backdrop { background: rgba(0, 0, 0, 0.9); }
.lightbox[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
.lb-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: calc(12px + env(safe-area-inset-top, 0px)) var(--gutter) 12px; font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.08em; }
.lb-stage { display: grid; place-items: center; padding: 0 var(--gutter); min-height: 0; }
.lb-stage img { max-width: 100%; max-height: 100%; object-fit: contain; }
.lb-caption { padding: 12px var(--gutter) calc(16px + env(safe-area-inset-bottom, 0px)); color: var(--ash); font-size: 0.95rem; text-align: center; }
.lb-btn { min-width: 44px; min-height: 44px; display: inline-grid; place-items: center; background: transparent; color: var(--chalk); border: 1px solid var(--steel); border-radius: 2px; cursor: pointer; font: 500 0.78rem/1 var(--mono); letter-spacing: 0.1em; text-transform: uppercase; padding: 0 14px; }
.lb-btn:hover { border-color: var(--chalk); }
.lb-nav { display: flex; gap: 8px; }

/* Simple pages */
.notice { display: grid; gap: 22px; max-width: 760px; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; animation: none !important; }
}
