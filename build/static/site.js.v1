(function () {
  var header = document.querySelector('.site-header');
  var toggle = document.querySelector('.menu-toggle');

  function closeMenus(except) {
    document.querySelectorAll('.has-menu.open').forEach(function (li) {
      if (li === except) return;
      li.classList.remove('open');
      var b = li.querySelector('.nav-link');
      if (b) b.setAttribute('aria-expanded', 'false');
    });
  }

  if (toggle && header) {
    toggle.addEventListener('click', function () {
      var open = header.classList.toggle('menu-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.classList.toggle('menu-locked', open);
    });
  }

  document.querySelectorAll('.has-menu > .nav-link').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var li = btn.parentElement;
      var willOpen = !li.classList.contains('open');
      closeMenus(li);
      li.classList.toggle('open', willOpen);
      btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    });
  });

  document.addEventListener('click', function (e) {
    if (!e.target.closest('.has-menu')) closeMenus();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    closeMenus();
    if (header && header.classList.contains('menu-open')) {
      header.classList.remove('menu-open');
      document.body.classList.remove('menu-locked');
      if (toggle) { toggle.setAttribute('aria-expanded', 'false'); toggle.focus(); }
    }
  });

  // Hero video: honour reduced motion, and give a pause control
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-video]').forEach(function (wrap) {
    var video = wrap.querySelector('video');
    var btn = wrap.querySelector('.video-toggle');
    if (!video) return;
    function setLabel() {
      if (!btn) return;
      var paused = video.paused;
      btn.querySelector('.txt').textContent = paused ? 'Play' : 'Pause';
      btn.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
      btn.querySelector('.i-pause').style.display = paused ? 'none' : '';
      btn.querySelector('.i-play').style.display = paused ? '' : 'none';
    }
    if (reduce) {
      video.removeAttribute('autoplay');
      video.pause();
    } else {
      var p = video.play();
      if (p && p.catch) p.catch(function () { setLabel(); });
    }
    video.addEventListener('play', setLabel);
    video.addEventListener('pause', setLabel);
    if (btn) btn.addEventListener('click', function () {
      if (video.paused) { var r = video.play(); if (r && r.catch) r.catch(function () {}); } else { video.pause(); }
    });
    setLabel();
  });

  // Project galleries open in a lightbox; without script the links open the full image
  var galleries = document.querySelectorAll('[data-gallery]');
  if (galleries.length && typeof HTMLDialogElement === 'function') {
    var dlg = document.createElement('dialog');
    dlg.className = 'lightbox';
    dlg.setAttribute('aria-label', 'Project photos');
    dlg.innerHTML =
      '<div class="lb-bar"><span class="lb-count"></span>' +
      '<div class="lb-nav"><button class="lb-btn" type="button" data-lb="prev" aria-label="Previous photo">Prev</button>' +
      '<button class="lb-btn" type="button" data-lb="next" aria-label="Next photo">Next</button>' +
      '<button class="lb-btn" type="button" data-lb="close" aria-label="Close">Close</button></div></div>' +
      '<div class="lb-stage"><img alt=""></div><p class="lb-caption"></p>';
    document.body.appendChild(dlg);
    var img = dlg.querySelector('img');
    var cap = dlg.querySelector('.lb-caption');
    var count = dlg.querySelector('.lb-count');
    var items = [], index = 0;

    function show(i) {
      index = (i + items.length) % items.length;
      var a = items[index];
      var thumb = a.querySelector('img');
      img.src = a.getAttribute('href');
      img.alt = thumb ? thumb.alt : '';
      cap.textContent = thumb ? thumb.alt : '';
      count.textContent = (index + 1) + ' / ' + items.length;
    }

    galleries.forEach(function (g) {
      var links = Array.prototype.slice.call(g.querySelectorAll('a'));
      links.forEach(function (a, i) {
        a.addEventListener('click', function (e) {
          e.preventDefault();
          items = links;
          show(i);
          dlg.showModal();
        });
      });
    });

    dlg.addEventListener('click', function (e) {
      var act = e.target.closest('[data-lb]');
      if (act) {
        var what = act.getAttribute('data-lb');
        if (what === 'prev') show(index - 1);
        else if (what === 'next') show(index + 1);
        else dlg.close();
        return;
      }
      if (e.target === dlg || e.target.classList.contains('lb-stage')) dlg.close();
    });
    dlg.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  }

  // Contact form: on the preview there is nowhere to send it yet
  var form = document.querySelector('form[data-preview]');
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.reportValidity()) return;
      var status = form.querySelector('.form-status');
      status.hidden = false;
      status.textContent = 'This is the preview of the new site, so nothing was sent. Once the site is live, messages from this form will go straight to ' + form.getAttribute('data-email') + '.';
    });
  }

  // Copy link on blog posts
  document.querySelectorAll('[data-copy]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-copy');
      var done = function (msg) { btn.textContent = msg; setTimeout(function () { btn.textContent = 'Copy link'; }, 2500); };
      var fallback = function () {
        var field = document.createElement('input');
        field.value = url; field.setAttribute('readonly', '');
        field.style.position = 'absolute'; field.style.left = '-9999px';
        document.body.appendChild(field); field.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
        document.body.removeChild(field);
        done(ok ? 'Link copied' : 'Copy failed');
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () { done('Link copied'); }, fallback);
      } else {
        fallback();
      }
    });
  });
})();
